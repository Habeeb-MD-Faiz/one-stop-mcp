# Copy to .env next to docker-compose.yml. Never commit the real file.
#
# Master key for the vault. Generate one with:
#   openssl rand -base64 32
# Losing it makes every stored credential unreadable; changing it does the same.
# Keep a copy in a password manager.
OSMCP_MASTER_KEY=

# Optional compose settings.
# OSMCP_PORT=8420          # host port
# OSMCP_BIND=127.0.0.1     # host address; 0.0.0.0 exposes plain HTTP, so put TLS in front first
# EMBEDDINGS=0             # 1 builds the image with the local-embedding dependencies
