          },
          "filters": {
            "type": "object",
            "description": "Filters: assignees, creators, task_statuses, asset_types, location and date ranges."
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Sort criteria (created_at or updated_at)."
          },
          "count": {
            "type": "integer",
            "description": "Results per page."
          },
          "cursor": {
            "type": "string",
