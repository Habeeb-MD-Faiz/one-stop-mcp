          "pageToken": {
            "type": "string",
            "description": "Token for the page to return."
          }
        }
      }
    },
    {
      "name": "list_events",
      "description": "Returns events from a given calendar that match all the specified constraints. Set time constraints only when the user asks for them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "calendarId": {
            "type": "string",
            "description": "Calendar ID or email address; defaults to the primary calendar."
          },
          "startTime": {
            "type": "string",
            "description": "Lower bound of the time range (ISO 8601)."
          },
          "endTime": {
            "type": "string",
            "description": "Upper bound of the time range (ISO 8601)."
          },
          "timeZone": {
            "type": "string",
            "description": "IANA time zone used to interpret dates without a zone."
          },
          "orderBy": {
            "type": "string",
            "description": "default, startTime, startTimeDesc or lastModified."
          },
          "fullText": {
            "type": "string",
            "description": "Case-insensitive search across title, description, location and attendees."
          },
          "eventType": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event types to return."
          },
          "pageSize": {
            "type": "integer",
            "description": "Maximum events per page."
          },
          "pageToken": {
            "type": "string",
            "description": "Token for the next page."
          }
        }
      }
    },
    {
