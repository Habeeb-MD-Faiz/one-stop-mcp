  "tools": [
    {
      "name": "search",
      "description": "Universal query-DSL search for conversations and contacts. The query must include object_type:conversations or object_type:contacts; supports field filters, q: free text, limit: and starting_after: cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Query string in the Intercom search DSL."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "fetch",
      "description": "Returns full details for specific resources by their type-prefixed IDs (conversation_, contact_, company_) from search results.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Type-prefixed resource ID."
          }
        }
      }
    },
