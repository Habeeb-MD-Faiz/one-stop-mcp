{
  "name": "one-stop-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP aggregation gateway — hundreds of MCP servers behind one endpoint, flat context cost.",
  "type": "module",
  "bin": {
    "one-stop-mcp": "dist/index.js"
  },
  "scripts": {
